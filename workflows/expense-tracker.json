      "parameters": {
        "resource": "image",
        "modelId": {
          "__rl": true,
          "value": "qwen2.5vl:3b",
          "mode": "list",
          "cachedResultName": "qwen2.5vl:3b"
        },
        "text": "\nAnalisa esta fatura portuguesa e extrai os seguintes campos:\n\nsupplier: nome legal do fornecedor\nsupplierNif: NIF do fornecedor\ninvoiceNumber: número da fatura\ninvoiceDate: data da fatura no formato YYYY-MM-DD\ntotal: valor final da fatura, com IVA incluído\natcud: ATCUD, caso exista\n\nRegras:\n- Devolve exclusivamente um objeto JSON válido.\n- Utiliza um número JSON para o valor monetário, sem símbolo de moeda.\n- Utiliza null quando não conseguires identificar um campo.\n- Não inventes valores.\n- O campo total deve representar o montante final a pagar, com IVA incluído.\n- Não confundas o total com o subtotal, a base tributável, o valor do IVA ou o troco.\n- Se existirem vários valores monetários, identifica o total final da fatura.\n- Não incluas os campos subtotal ou vat na resposta.\n- Não acrescentes explicações nem blocos Markdown.\n  ",
        "simplify": false,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        832,
        -64
      ],
      "id": "60b22310-c9c0-439b-9023-1f0de1b060e7",
      "name": "Analyze image",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n/* === 1. Parse Ollama response === */\n\nconst raw = $json.message?.content ?? \"\"; // resposta do Ollama; se não existir, usamos texto vazio\n\nconst cleaned = raw // remove caracteres desnecessários da resposta\n  .replace(/```json\\s*/gi, \"\")\n  .replace(/```\\s*/g, \"\")\n  .trim();\n\nlet invoice;\nlet error = null;\n\ntry {\n  invoice = JSON.parse(cleaned); // transforma uma string JSON num objeto JavaScript\n\n  // Verifica se o resultado é realmente um objeto e não null, array ou outro tipo\n  if (\n    invoice === null ||\n    typeof invoice !== \"object\" ||\n    Array.isArray(invoice)\n  ) {\n    throw new Error(\"Invalid JSON object\");\n  }\n\n} catch (err) {\n  invoice = null;\n  error = \"invalid_ollama_response\";\n}\n\n/* === 2. Handle invalid Ollama response === */\n\nif (invoice === null) { // se a resposta for inválida, devolvemos os campos a null\n\n  return {\n    json: {\n      supplier: null,\n      supplierNif: null,\n      invoiceNumber: null,\n      invoiceDate: null,\n      total: null,\n      atcud: null,\n      attachmentId: $('Extraia anexos').item.json.attachmentId,\n      hasValidDate: false,\n      hasValidTotal: false,\n      status: \"pending_review\",\n      error\n    }\n  };\n}\n\n/* === 3. Validate date === */\n\nconst hasValidDate =\n  typeof invoice.invoiceDate === \"string\" && // verifica se a data é texto\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(invoice.invoiceDate) && // verifica o formato YYYY-MM-DD\n  (() => {\n    const [year, month, day] = invoice.invoiceDate\n      .split(\"-\") // transforma \"2026-08-18\" em [\"2026\", \"08\", \"18\"]\n      .map(Number); // converte os textos em números [2026, 8, 18]\n\n    const date = new Date(Date.UTC(year, month - 1, day)); // cria uma data em UTC\n\n    return ( // confirma que a data criada corresponde à data original\n      date.getUTCFullYear() === year &&\n      date.getUTCMonth() === month - 1 &&\n      date.getUTCDate() === day\n    );\n  })();\n\n/* === 4. Validate total === */\n\n/**\n * Exigimos que o total seja:\n * - Um número finito.\n * - Maior ou igual a zero.\n */\n\nconst hasValidTotal =\n  Number.isFinite(invoice.total) && // verifica se é um número válido\n  invoice.total >= 0; // verifica se não é negativo\n\n/* === 5. Determine invoice status === */\n\n/**\n * Para atribuir \"validated\", precisamos de:\n * - Data válida.\n * - Total válido.\n *\n * Já não verificamos subtotal + IVA = total.\n */\n\nlet status;\n\nif (\n  hasValidDate &&\n  hasValidTotal\n) {\n  status = \"validated\";\n} else {\n  status = \"pending_review\";\n}\n\n/* === 6. Return structured data === */\n\nreturn { // cria o item que vai seguir para o Merge e Google Sheets\n  json: {\n    supplier: invoice.supplier ?? null,\n    supplierNif: invoice.supplierNif ?? null,\n    invoiceNumber: invoice.invoiceNumber ?? null,\n    invoiceDate: invoice.invoiceDate ?? null,\n    total: invoice.total ?? null,\n    atcud: invoice.atcud ?? null,\n\n    // Recupera o identificador do anexo original\n    attachmentId: $('Extraia anexos').item.json.attachmentId,\n\n    hasValidDate,\n    hasValidTotal,\n    status\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        -64
      ],
      "id": "a98b5792-c7e7-4c78-b9bc-e0a090cbd940",
      "name": "Limpa mensagem"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all(); //Obter os dados de entrada\nconst result = [];\n\nconst allowedTypes = [\n  \"application/pdf\",\n  \"image/jpeg\",\n  \"image/png\"\n];\n\n//percorre todos os emails recebidos\nfor (const [itemIndex, item] of items.entries()) {\n\n  //busca chave dos ficheiros\n  const keys = Object.keys(item.binary ?? {});\n\n  //percorre por cada chave\n  for (const key of keys) {\n\n    //busca chave de um ficheiro\n    const attachment = item.binary[key];\n\n    //Id único do documento\n    const attachmentId = `${item.json.id}_${key}`;\n    \n    // Aqui estamos a trabalhar com um anexo específico.\n    // verifica se é dos tipos permitidos\n    if (allowedTypes.includes(attachment.mimeType)) {\n     //adiciona ao array um json com a chave, nome e tipo\n      result.push({\n        json:{\n          attachmentId: attachmentId,\n          key: key,\n          filename: attachment.fileName,\n          mimeType: attachment.mimeType\n        },\n        binary: {data: attachment},\n        pairedItem: {item: itemIndex}\n      })\n    }\n  }\n}\n\nreturn result;"
      },
